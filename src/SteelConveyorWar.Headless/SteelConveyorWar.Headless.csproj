<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SteelConveyorWar.Headless</RootNamespace>
    <AssemblyName>SteelConveyorWar.Headless</AssemblyName>
    <Description>Headless bot/CI host entrypoint (Core + Hosting bootstrap, no SFML window).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteelConveyorWar.Core\SteelConveyorWar.Core.csproj" />
    <ProjectReference Include="..\SteelConveyorWar.Hosting\SteelConveyorWar.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\config\*.json" Link="config\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\maps\**\*.json" Link="config\maps\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
